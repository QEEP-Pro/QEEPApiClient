{
    "name": "qeep-pro/qeep-api-client",
    "description": "Client for QEEP-Pro API",
    "keywords": ["api", "client"],
    "license": "MIT",
    "authors": [
        {
            "name": "QEEP-Pro",
            "email": "info@qeep.pro"
        }
    ],
    "config": {
        "bin-dir": "bin"
    },
    "scripts": {
        "lint": "php bin/php-cs-fixer fix ./src -v --dry-run --stop-on-violation --using-cache=no",
        "fix-style": "php bin/php-cs-fixer fix ./src",
        "test": "php bin/phpspec run"
    },
    "require": {
        "php": ">=7.2",
        "ext-curl": "*",
        "ext-json": "*",

        "jms/serializer": "^3.29.0"
    },
    "require-dev": {
        "phpspec/phpspec": "^7.6.0",
        "php-mock/php-mock-prophecy": "^0.1.4",
        "php-mock/php-mock": "^2.6.2",
        "friendsofphp/php-cs-fixer": "^3.90.0"
    },
    "autoload": {
        "psr-4": {
            "QEEP\\QEEPApiClient\\": "src/"
        }
    }
}
